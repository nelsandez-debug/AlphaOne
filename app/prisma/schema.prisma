// Phase 0 — foundation schema (auth, permissions, shared documents/notes/audit_log).
// Phase 1 — core entities (Supplier, Contract, Service) below, everything else in the
// platform will reference these three by real foreign key.
//
// documents / notes / ownership are intentionally polymorphic (recordType + recordId)
// per CLAUDE.md — every module (including Supplier/Contract/Service here) attaches to
// these same shared tables instead of building its own.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Matches the reference prototype's role list (Administration → Roles & Permissions).
enum Role {
  EXECUTIVE
  PROCUREMENT_LEADER
  CATEGORY_MANAGER
  BUYER
  APPROVER
  FINANCE_ANALYST
  ACCOUNTS_PAYABLE
  COMPLIANCE_OFFICER
  IT_ADMINISTRATOR
  AUDITOR
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
  APPROVE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       Document[]
  notes           Note[]
  auditLogEntries AuditLogEntry[]
  ownerships      Ownership[]
  intakeRequests  IntakeRequest[]
}

// The DB-backed equivalent of the reference's PERMISSIONS_MATRIX: a real
// (role, module) -> level relation instead of an array indexed by module name,
// so Administration -> Roles & Permissions (Phase 6) can edit it as data.
model Module {
  id    String @id @default(cuid())
  key   String @unique
  label String

  rolePermissions RolePermission[]
}

model RolePermission {
  id       String           @id @default(cuid())
  role     Role
  moduleId String
  module   Module           @relation(fields: [moduleId], references: [id])
  level    PermissionLevel  @default(NONE)

  @@unique([role, moduleId])
}

model Document {
  id           String   @id @default(cuid())
  recordType   String
  recordId     String
  name         String
  sizeKB       Int?
  storageKey   String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([recordType, recordId])
}

model Note {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  text       String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([recordType, recordId])
}

// Append-only by convention: the application layer only ever creates rows here,
// never updates or deletes them. When an action creates a downstream record
// (e.g. an intake disposition creating a Contract), createdRecordType/Id stores
// a real reference to it rather than a text label.
model AuditLogEntry {
  id                String   @id @default(cuid())
  recordType        String
  recordId          String
  actorId           String?
  actor             User?    @relation(fields: [actorId], references: [id])
  action            String
  metadata          Json?
  createdRecordType String?
  createdRecordId   String?
  createdAt         DateTime @default(now())

  @@index([recordType, recordId])
}

// Current owner of any record type — one row per (recordType, recordId), reassigned
// via upsert. Kept as its own shared/polymorphic table (like Document/Note) rather
// than an ownerId column duplicated on Supplier/Contract/Service/etc., so a future
// cross-module ownership leaderboard (Administration, Phase 6) queries real data
// instead of unioning per-table columns.
model Ownership {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([recordType, recordId])
}

// ---------------------------------------------------------------------------
// Phase 1 — core entities
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SupplierTier {
  STRATEGIC
  PREFERRED
  PARTNER
  TRANSACTIONAL
  UNMANAGED
}

enum SupplierStatus {
  PREFERRED
  APPROVED
  UNDER_REVIEW
  PENDING_ONBOARDING
}

model Supplier {
  id        String         @id @default(cuid())
  name      String
  category  String
  tier      SupplierTier
  status    SupplierStatus
  riskLevel RiskLevel?
  riskScore Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  contracts Contract[]
  services  Service[]

  sourcingParticipations SourcingEventSupplier[]
  purchaseOrders         PurchaseOrder[]
  invoices               Invoice[]
  vendorSlas             VendorSla[]
  businessReviews        BusinessReview[]
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  BREACH_FLAGGED
}

model Contract {
  id             String         @id @default(cuid())
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  name           String
  // Free-form per the reference prototype (MSA, NDA, DPA, Service Order, Addendum,
  // Rate Schedule, ...) — too varied a taxonomy to lock into a Postgres enum yet.
  type           String
  status         ContractStatus
  riskLevel      RiskLevel?
  effectiveDate  DateTime?
  expirationDate DateTime?
  autoRenew      Boolean        @default(false)
  governingLaw   String?
  summary        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  services       Service[]
  purchaseOrders PurchaseOrder[]

  @@index([supplierId])
}

enum ServiceCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Service {
  id          String             @id @default(cuid())
  supplierId  String
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  contractId  String?
  contract    Contract?          @relation(fields: [contractId], references: [id])
  name        String
  category    String
  criticality ServiceCriticality
  // "Governed" / "Gap Identified" / etc. per the reference — free text for now.
  governanceStatus String?
  riskScore        Int?
  // Multi-category risk ratings (Information Security, Data Privacy, ...): record-owned
  // attribute data, not a link to another record, so a JSON blob is the right shape here
  // (unlike Supplier/Contract references, which are real FKs). Normalize into its own
  // table if/when Risk Management (Phase 5) needs to query individual categories.
  riskAssessment   Json?
  lastReviewedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([supplierId])
  @@index([contractId])
}

// ---------------------------------------------------------------------------
// Phase 2 — front door (Intake + disposition)
// ---------------------------------------------------------------------------

enum IntakeRequestType {
  SERVICE_REQUEST
  NEW_VENDOR
  CONTRACT_REQUEST
  CONTRACT_CHANGE
  PURCHASE_REQUEST
  NEW_PROJECT
  SOURCING_EVENT
}

enum IntakeStage {
  NEW
  TRIAGE
  ROUTED
  IN_PROGRESS
  CLOSED
}

// The disposition history itself is NOT a field on this model — unlike the reference
// prototype's embedded `dispositions: []` array, it's real AuditLogEntry rows
// (recordType "intake_request") reusing the Phase 0 shared audit system, with
// createdRecordType/createdRecordId as the real FK to whatever Supplier/Contract/
// Service the disposition created (never a text label).
model IntakeRequest {
  id            String            @id @default(cuid())
  title         String
  type          IntakeRequestType
  category      String?
  description   String?
  estimatedValue Int?
  neededBy      DateTime?
  costCenter    String?
  department    String?
  requesterId   String
  requester     User              @relation(fields: [requesterId], references: [id])
  stage         IntakeStage       @default(NEW)
  dispositionedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  purchaseOrders PurchaseOrder[]
}

// ---------------------------------------------------------------------------
// Phase 3 — transacting (Sourcing, Purchase Orders, Invoices, Vendor Management)
// ---------------------------------------------------------------------------

// Reference prototype's sourcing events tracked participation as a bare
// `invitedSuppliers: string[]` of names (matched elsewhere by `=== supplier.name`)
// and a `suppliers` count that wasn't even derived from that list. Both are real
// relations here: SourcingEventSupplier is the join, with a per-supplier status.
enum SourcingStage {
  MARKET_SCAN
  BID_EVALUATION
  AWARD_OPTIMIZATION
  CLOSED
}

model SourcingEvent {
  id                String          @id @default(cuid())
  title             String
  // Free text (RFP/RFQ/RFI) — the reference only ever embedded this in the title
  // string; pulled into a real field here so it's actually filterable.
  type              String?
  stage             SourcingStage   @default(MARKET_SCAN)
  estimatedSavings  Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  participants SourcingEventSupplier[]
}

enum SourcingParticipantStatus {
  INVITED
  RESPONDED
  SHORTLISTED
  AWARDED
  DECLINED
}

model SourcingEventSupplier {
  id              String                    @id @default(cuid())
  sourcingEventId String
  sourcingEvent   SourcingEvent             @relation(fields: [sourcingEventId], references: [id])
  supplierId      String
  supplier        Supplier                  @relation(fields: [supplierId], references: [id])
  status          SourcingParticipantStatus @default(INVITED)
  createdAt       DateTime                  @default(now())

  @@unique([sourcingEventId, supplierId])
}

enum POType {
  STANDARD
  BLANKET
  SERVICE
  EMERGENCY
  RECURRING
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  RECEIVED
  CLOSED
}

model PurchaseOrder {
  id                  String    @id @default(cuid())
  supplierId          String
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
  // Neither field exists in the reference (POs there carry a loose `req: "REQ-901"`
  // string with no lookup, and no contract reference at all) — both are real,
  // optional FKs here so provenance and contract coverage are actually queryable.
  contractId          String?
  contract            Contract? @relation(fields: [contractId], references: [id])
  originIntakeRequestId String?
  originIntakeRequest   IntakeRequest? @relation(fields: [originIntakeRequestId], references: [id])
  type                POType
  status              POStatus  @default(DRAFT)
  amount              Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  invoices Invoice[]

  @@index([supplierId])
  @@index([contractId])
}

enum InvoiceStatus {
  PENDING
  MATCHED
  EXCEPTION
  DISPUTED
  PAID
}

model Invoice {
  id              String        @id @default(cuid())
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  // Real FK replacing the reference's untyped `poId` string equality match.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Int
  status          InvoiceStatus @default(PENDING)
  matchConfidence Int?
  onHold          Boolean       @default(false)
  holdReason      String?
  overageAmount   Int?
  overageApproved Boolean?
  overageNote     String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  paymentTerms    String?
  department      String?
  category        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([supplierId])
  @@index([purchaseOrderId])
}

// Vendor Management is a governance layer over Suppliers/Invoices, same as the
// reference — but VendorSla/BusinessReview reference Supplier by real FK instead
// of a `supplier` name string, and "held invoices" is just a query against
// Invoice.onHold (no separate hold-management table, matching how the reference
// only ever surfaced/aggregated the flag rather than owning it).
enum VendorSlaStatus {
  MET
  AT_RISK
  BREACHED
  NOT_TRACKED
}

model VendorSla {
  id                String          @id @default(cuid())
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  metric            String
  target            String
  actual            String?
  status            VendorSlaStatus @default(NOT_TRACKED)
  enforcementAction String?
  enforcementDate   DateTime?
  enforcementNote   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([supplierId])
}

enum BusinessReviewType {
  QBR
  ANNUAL_REVIEW
}

enum BusinessReviewStatus {
  SCHEDULED
  COMPLETED_ON_TIME
  COMPLETED_LATE
  OVERDUE
}

model BusinessReview {
  id            String               @id @default(cuid())
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  type          BusinessReviewType
  scheduledDate DateTime
  status        BusinessReviewStatus @default(SCHEDULED)
  completedDate DateTime?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([supplierId])
}
